# Conexión a MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mrti_activos

# Servidor
PORT=3003
# CORS_ORIGIN=http://localhost:5173

# SSO: valida la sesión reenviando el header Authorization a MRTI Core.
# MRTI_INFRA_URL se conserva como fallback de rollback (Fase 4 de
# CORE_INFRA_MIGRATION_GUIDE.md) — no se borra hasta retirar la ruta vieja.
MRTI_CORE_URL=http://127.0.0.1:3005
MRTI_INFRA_URL=http://127.0.0.1:3002

# Validación en vivo de referencias al clasificar una unidad del catálogo
# (ver domain/unitReview.js, integrations/obsClient.js y rhClient.js). Nunca
# se copian esas tablas; sólo se consulta un id puntual con la sesión del
# administrador que clasifica.
MRTI_OBS_URL=http://127.0.0.1:3002
MRTI_RH_URL=http://127.0.0.1:3004

# Nombre temporal de la base que usa MRTI-Obs. Sólo lo consume el script
# idempotente de conciliación; la aplicación nunca consulta otra base por SQL.
MRTI_OBS_DATABASE=mrti_infra

# Integración en vivo con SAP (ActivosTI, SQL Server) -- ver
# server/src/integrations/sapClient.js y sapSync.js. El login configurado
# aquí debe tener db_owner únicamente sobre esa base, sin rol de servidor.
SAP_DB_HOST=
SAP_DB_PORT=1433
SAP_DB_NAME=ActivosTI
SAP_DB_USER=
SAP_DB_PASSWORD=
# SAP_SYNC_CRON=*/15 * * * *

# Llave de cifrado (genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# para las columnas de password que sí se traen desde SAP (NVR, Passwords de
# red) -- nunca en texto plano.
CREDENTIALS_ENCRYPTION_KEY=

# Los PDF migrados se guardan fuera del frontend y sólo se descargan tras
# validar la sesión del módulo. El segundo valor sólo se usa una vez durante
# la importación desde el sistema anterior.
# ASSET_DOCUMENTS_DIR=/var/www/mrt/MRTI/MRTI-Activos/server/storage/asset-documents
# INCOMING_ACTIVOS_UPLOAD_DIR=/var/www/mrt/MRTI/_incoming-activos/ti-assets/backend/uploads
