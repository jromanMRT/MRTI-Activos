# Fuente externa de inventario. Copia este archivo como `.env.external` sólo
# cuando el administrador de la base entregue una cuenta exclusiva de lectura.
# `.env.external` está ignorado por Git y nunca debe enviarse por chat.
EXTERNAL_MYSQL_HOST=192.168.1.75
EXTERNAL_MYSQL_PORT=3306
EXTERNAL_MYSQL_USER=mrti_import_reader
EXTERNAL_MYSQL_PASSWORD=
EXTERNAL_MYSQL_DATABASE=
EXTERNAL_MYSQL_CONNECT_TIMEOUT_MS=5000

# Activa TLS únicamente si el servidor lo ofrece con un certificado válido.
EXTERNAL_MYSQL_SSL=false
